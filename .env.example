# ============================================================================
# Ben - environment configuration. Copy to `.env` and fill in.
# Never commit `.env`. Secrets are read as SecretStr and never logged.
# ============================================================================

# --- Claude (Anthropic API) ---------------------------------------------------
# API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model ID. The ONLY place the model is configured. Default: claude-sonnet-5
BEN_MODEL=claude-sonnet-5
# Max tokens per model response
BEN_MAX_TOKENS=4096
# Max tool-use rounds per answer before Ben must answer with what it has
BEN_MAX_TOOL_ROUNDS=6
# Reasoning effort: low | medium | high | xhigh | max (leave empty for model default)
BEN_EFFORT=medium

# --- Paths & storage ----------------------------------------------------------
# Where the SQLite DB, vector index, model cache and exports live
DATA_DIR=./data
# Default folder for `ben ingest`
KNOWLEDGE_DIR=./knowledge
# Folder containing system.md
PROMPTS_DIR=./prompts
# Database URL. Empty = sqlite:///$DATA_DIR/ben.db
# Postgres example (install with `uv sync --extra postgres`):
#   DATABASE_URL=postgresql+psycopg://ben:password@db-host:5432/ben
DATABASE_URL=
# LanceDB directory. Empty = $DATA_DIR/lancedb
VECTOR_DIR=

# --- Retrieval ----------------------------------------------------------------
# fastembed (local ONNX model) | hash (offline, lexical-only; for tests/air-gapped smoke runs)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed caches the model. Empty = $DATA_DIR/models
EMBEDDING_CACHE_DIR=
# Passages returned per search
RETRIEVAL_TOP_K=6
# Combine BM25 full-text and vector search (Reciprocal Rank Fusion)
HYBRID_SEARCH=true
# Chunk size and overlap in characters
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=200

# --- Conversation -------------------------------------------------------------
# Number of previous user/assistant turns Ben remembers per chat
BEN_HISTORY_TURNS=10

# --- Telegram -----------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends in X-Telegram-Bot-Api-Secret-Token (1-256 chars: A-Z a-z 0-9 _ -)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL of this server, e.g. https://ben.example.com (used by `ben set-webhook`)
TELEGRAM_WEBHOOK_URL=
# Comma-separated numeric Telegram user IDs allowed to use Ben. Empty = nobody.
TELEGRAM_ALLOWED_USER_IDS=

# --- WhatsApp Cloud API -------------------------------------------------------
# Permanent (System User) access token for your Meta app
WHATSAPP_ACCESS_TOKEN=
# Phone number ID (not the phone number) from WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Secret (App settings > Basic) - used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Any random string; enter the same value as "Verify token" when configuring the webhook
WHATSAPP_VERIFY_TOKEN=
# Graph API version
WHATSAPP_API_VERSION=v21.0
# Comma-separated phone numbers (international format, + optional) allowed. Empty = nobody.
WHATSAPP_ALLOWED_NUMBERS=

# --- Security & governance ----------------------------------------------------
# Messages per minute per user (0 disables), and burst size
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5
# Redact PII (emails, phones, Emirates ID, passport numbers, booking refs) in logs & memory
REDACT_BEFORE_LOGGING=true
# Also redact PII before sending the user's message to the model
REDACT_BEFORE_MODEL=false
# Delete conversations not updated for this many days (0 = keep)
RETENTION_DAYS=90
# Delete audit log entries older than this many days (0 = keep forever)
AUDIT_RETENTION_DAYS=365
# Hour (UTC) the daily retention cleanup runs inside `ben serve`
CLEANUP_HOUR_UTC=3
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
